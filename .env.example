PORT=3000

# Recommended: Resend (works for real Gmail recipients once configured)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM="LingoEnglish <onboarding@yourdomain.com>"

# Optional fallback: Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="LingoEnglish <your-gmail@gmail.com>"
